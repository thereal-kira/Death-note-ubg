-- Features

-- FPS
local frames, lastTime = 0, tick()
RunService.RenderStepped:Connect(function()
	frames += 1
	if tick() - lastTime >= 1 then
		fpsLabel.Text = "FPS: " .. frames
		frames = 0
		lastTime = tick()
	end
end)

-- Speed
RunService.Heartbeat:Connect(function()
	pcall(function()
		if S.Speed then
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = S.SpeedValue
			end
		end
	end)
end)

-- Anti Stun
RunService.Heartbeat:Connect(function()
	pcall(function()
		if S.AntiStun then
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			end
		end
	end)
end)

-- Hitbox
RunService.Heartbeat:Connect(function()
	pcall(function()
		if not S.Hitbox then return end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				if S.IgnoreFriends and LocalPlayer:IsFriendsWith(plr.UserId) then continue end
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				if root then
					root.Size = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
					root.Transparency = 0.55
					root.CanCollide = false
					root.Massless = true
				end
			end
		end
	end)
end)

-- Kill Aura
RunService.Heartbeat:Connect(function()
	pcall(function()
		if not S.KillAura then return end
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				if S.IgnoreFriends and LocalPlayer:IsFriendsWith(plr.UserId) then continue end
				local eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
				local eHum = plr.Character:FindFirstChildOfClass("Humanoid")
				if eRoot and eHum and eHum.Health > 0 then
					if (root.Position - eRoot.Position).Magnitude <= S.AuraRange then
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
						task.wait(0.04)
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
						break
					end
				end
			end
		end
	end)
end)

-- ESP
RunService.Heartbeat:Connect(function()
	pcall(function()
		if S.ESP then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character and not plr.Character:FindFirstChild("KiraESP") then
					if S.IgnoreFriends and LocalPlayer:IsFriendsWith(plr.UserId) then continue end
					local hl = Instance.new("Highlight")
					hl.Name = "KiraESP"
					hl.FillColor = Color3.fromRGB(255, 50, 50)
					hl.OutlineColor = Color3.new(1, 1, 1)
					hl.FillTransparency = 0.45
					hl.Parent = plr.Character
				end
			end
		else
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr.Character then
					local h = plr.Character:FindFirstChild("KiraESP")
					if h then h:Destroy() end
				end
			end
		end
	end)
end)

-- Fly
local bv, bg
RunService.RenderStepped:Connect(function()
	pcall(function()
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end

		if S.Fly then
			hum.PlatformStand = true
			if not bv then
				bv = Instance.new("BodyVelocity")
				bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
				bv.Parent = root
			end
			if not bg then
				bg = Instance.new("BodyGyro")
				bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
				bg.Parent = root
			end
			bv.Velocity = hum.MoveDirection * S.FlySpeed
			bg.CFrame = Camera.CFrame
		else
			hum.PlatformStand = false
			if bv then bv:Destroy() bv = nil end
			if bg then bg:Destroy() bg = nil end
		end
	end)
end)

