-- Hitbox
RunService.Heartbeat:Connect(function()
    pcall(function()
        if not Settings.Hitbox then return end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                    root.Transparency = 0.6
                    root.CanCollide = false
                    root.Massless = true
                end
            end
        end
    end)
end)

-- Kill Aura
RunService.Heartbeat:Connect(function()
    pcall(function()
        if not Settings.KillAura then return end
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local eRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local eHum = plr.Character:FindFirstChild("Humanoid")
                if eRoot and eHum and eHum.Health > 0 then
                    if (root.Position - eRoot.Position).Magnitude <= Settings.KillAuraRange then
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        task.wait(0.04)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        break
                    end
                end
            end
        end
    end)
end)

-- ESP
local function AddESP(plr)
    pcall(function()
        if plr == LocalPlayer then return end
        local char = plr.Character
        if not char or char:FindFirstChild("KiraESP") then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "KiraESP"
        highlight.FillColor = Color3.fromRGB(255, 50, 50)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.Parent = char
    end)
end

RunService.Heartbeat:Connect(function()
    pcall(function()
        if Settings.ESP then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character and not plr.Character:FindFirstChild("KiraESP") then
                    AddESP(plr)
                end
            end
        else
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character then
                    local h = plr.Character:FindFirstChild("KiraESP")
                    if h then h:Destroy() end
                end
            end
        end
    end)
end)

-- Fly
local BV, BG
local function ToggleFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    Settings.Fly = not Settings.Fly

    if Settings.Fly then
        hum.PlatformStand = true
        BV = Instance.new("BodyVelocity")
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BV.Velocity = Vector3.zero
        BV.Parent = root
        BG = Instance.new("BodyGyro")
        BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        BG.Parent = root
        Notify("Fly", "الطيران شغال")
    else
        hum.PlatformStand = false
        if BV then BV:Destroy() end
        if BG then BG:Destroy() end
        Notify("Fly", "الطيران تطفا")
    end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Settings.Fly then return end
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root or not BV or not BG then return end

        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end

        BV.Velocity = dir.Magnitude > 0 and dir.Unit * Settings.FlySpeed or Vector3.zero
        BG.CFrame = Camera.CFrame
    end)
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then
        ToggleFly()
    end
end)

