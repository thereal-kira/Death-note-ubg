-- ESP
RunService.Heartbeat:Connect(function()
    pcall(function()
        if Settings.ESP then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and not plr.Character:FindFirstChild("KiraESP") then
                    if Settings.IgnoreFriends and LocalPlayer:IsFriendsWith(plr.UserId) then continue end
                    local hl = Instance.new("Highlight")
                    hl.Name = "KiraESP"
                    hl.FillColor = Color3.fromRGB(255, 40, 40)
                    hl.OutlineColor = Color3.new(1,1,1)
                    hl.FillTransparency = 0.4
                    hl.Parent = plr.Character
                end
            end
        else
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Character then
                    local h = plr.Character:FindFirstChild("KiraESP")
                    if h then h:Destroy() end
                end
            end
        end
    end)
end)

-- Anti Lag
RunService.Heartbeat:Connect(function()
    pcall(function()
        if Settings.AntiLag then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") then
                    v.Enabled = false
                end
            end
        end
    end)
end)

-- Fly
local BV, BG
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum then return end

        if Settings.Fly then
            hum.PlatformStand = true
            if not BV then
                BV = Instance.new("BodyVelocity")
                BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                BV.Parent = root
            end
            if not BG then
                BG = Instance.new("BodyGyro")
                BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                BG.Parent = root
            end
            BV.Velocity = hum.MoveDirection * Settings.FlySpeed
            BG.CFrame = Camera.CFrame
        else
            hum.PlatformStand = false
            if BV then BV:Destroy() BV = nil end
            if BG then BG:Destroy() BG = nil end
        end
    end)
end)

